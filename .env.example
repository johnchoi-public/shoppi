# Copy to .env and fill in.

# --- Google OAuth ---
# Download the "Desktop app" OAuth client JSON from Google Cloud Console.
SHOPPI_GOOGLE_CLIENT_SECRETS_FILE=secrets/client_secret.json

# --- Token encryption ---
# Generate with: python -m shoppi.storage.token_store
SHOPPI_TOKEN_KEY=
SHOPPI_TOKEN_FILE=secrets/google_token.enc

# --- User ---
# IANA timezone injected into prompts and used for date math.
SHOPPI_TIMEZONE=America/New_York

# --- Chat model (provider-agnostic; any LangChain provider name) ---
SHOPPI_LLM_PROVIDER=ollama
SHOPPI_LLM_MODEL=nemotron-3.5-lightning
# SHOPPI_LLM_BASE_URL=            # e.g. a vLLM server later: provider=openai + http://host:8000/v1

# --- Embeddings for the document store (run: ollama pull nomic-embed-text) ---
SHOPPI_EMBEDDING_PROVIDER=ollama
SHOPPI_EMBEDDING_MODEL=nomic-embed-text

# --- Document store ---
SHOPPI_DOCS_DIR=docs_store/source
SHOPPI_VECTOR_DIR=docs_store/chroma
# SHOPPI_LLM_NUM_CTX=8192        # Ollama only: cap context to reduce memory use

# --- Calendar backend ---
# "local" = internal SQLite calendar (default), "google" = your Google Calendar.
SHOPPI_CALENDAR_PROVIDER=local
SHOPPI_CALENDAR_DB_URL=sqlite:///data/calendar.db
