# Copy to .env and fill in. Every variable is optional except SHOPPI_TOKEN_KEY
# (needed as soon as you connect an integration).

# --- Database (Postgres with the pgvector, btree_gist and pgcrypto extensions) ---
# The app connects as a restricted role so row-level security applies to it;
# migrations run as the schema owner. scripts/setup_db.sh creates both for local use.
SHOPPI_DATABASE_URL=postgresql+psycopg://shoppi_app:shoppi_app_dev@localhost:5432/shoppi
SHOPPI_DATABASE_OWNER_URL=postgresql+psycopg://shoppi_owner:shoppi_owner_dev@localhost:5432/shoppi

# --- Web ---
# Public address of the app: used in invite links, intake links and OAuth redirects.
SHOPPI_BASE_URL=http://localhost:8000
# Set to true when served over HTTPS.
SHOPPI_COOKIE_SECURE=false

# --- Encryption key for integration credentials ---
# Generate with: python -m shoppi.integrations.credentials
SHOPPI_TOKEN_KEY=

# --- Chat model (provider-agnostic; any LangChain provider name) ---
SHOPPI_LLM_PROVIDER=ollama
SHOPPI_LLM_MODEL=nemotron-3.5-lightning
# SHOPPI_LLM_BASE_URL=           # e.g. a vLLM / OpenAI-compatible server: provider=openai + http://host:8000/v1
# SHOPPI_LLM_NUM_CTX=8192        # Ollama only: cap context to reduce memory use
# Hosted example (pip install langchain-anthropic, set ANTHROPIC_API_KEY):
# SHOPPI_LLM_PROVIDER=anthropic
# SHOPPI_LLM_MODEL=claude-sonnet-5-5

# --- Embeddings for the knowledge base (run: ollama pull nomic-embed-text) ---
SHOPPI_EMBEDDING_PROVIDER=ollama
SHOPPI_EMBEDDING_MODEL=nomic-embed-text
# Must match the model's vector width. Changing it later means re-creating the index.
SHOPPI_EMBEDDING_DIM=768

# --- Google (optional): "Sign in with Google" and the Google Calendar mirror ---
# Create an OAuth "Web application" client and add these redirect URIs:
#   <SHOPPI_BASE_URL>/api/auth/google/callback
#   <SHOPPI_BASE_URL>/api/integrations/google_calendar/callback
# SHOPPI_GOOGLE_CLIENT_ID=
# SHOPPI_GOOGLE_CLIENT_SECRET=
